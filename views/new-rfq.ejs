<!DOCTYPE html>
<html>
<head>
    <title>Post RFQ - TradeConnect</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">🏢 TradeConnect</a>
            <a href="/dashboard" class="btn btn-outline-light btn-sm">← Back</a>
        </div>
    </nav>

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow">
                    <div class="card-header bg-success text-white">
                        <h4>📝 Post a Buying Request (RFQ)</h4>
                    </div>
                    <div class="card-body">
                        <% if (error) { %>
                            <div class="alert alert-danger"><%= error %></div>
                        <% } %>
                        <form method="POST" action="/rfq/new">
                            <div class="mb-3">
                                <label>Product Name *</label>
                                <input type="text" name="productName" class="form-control" required>
                            </div>
                            <div class="mb-3">
                                <label>Category *</label>
                                <select name="category" class="form-select" required>
                                    <option value="">Select...</option>
                                    <option>Electronics</option>
                                    <option>Textiles</option>
                                    <option>Food & Beverage</option>
                                    <option>Machinery</option>
                                    <option>Chemicals</option>
                                    <option>Automotive</option>
                                </select>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label>Quantity</label>
                                    <input type="number" name="quantity" class="form-control">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label>Target Price</label>
                                    <div class="input-group">
                                        <input type="number" name="targetPrice" class="form-control" step="0.01">
                                        <select name="currency" class="form-select" style="max-width: 100px;">
                                            <option>USD</option>
                                            <option>EUR</option>
                                            <option>GBP</option>
                                            <option>CNY</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label>Destination Country</label>
                                    <input type="text" name="destination" class="form-control">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label>Quote Deadline</label>
                                    <input type="date" name="deadline" class="form-control">
                                </div>
                            </div>
                            <div class="mb-3">
                                <label>Additional Details</label>
                                <textarea name="description" class="form-control" rows="4"></textarea>
                            </div>
                            <button type="submit" class="btn btn-success btn-lg w-100">🚀 Submit RFQ</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

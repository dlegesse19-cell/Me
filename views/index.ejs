<!DOCTYPE html>
<html>
<head>
    <title>TradeConnect</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">🏢 TradeConnect</a>
            <div>
                <% if (user) { %>
                    <span class="text-light me-3">Welcome, <%= user.companyName %></span>
                    <a href="/dashboard" class="btn btn-outline-light btn-sm">Dashboard</a>
                    <a href="/auth/logout" class="btn btn-danger btn-sm">Logout</a>
                <% } else { %>
                    <a href="/auth/login" class="btn btn-outline-light btn-sm">Login</a>
                    <a href="/auth/register" class="btn btn-primary btn-sm">Register</a>
                <% } %>
            </div>
        </div>
    </nav>
    <div class="container mt-5">
        <div class="text-center">
            <h1>Connect Importers & Traders</h1>
            <p>Find trusted trading partners worldwide</p>
            <a href="/auth/register" class="btn btn-primary btn-lg">Get Started</a>
        </div>
        <hr>
        <h2 class="text-center">Latest Listings</h2>
        <div class="row">
            <% listings.forEach(listing => { %>
                <div class="col-md-4 mb-3">
                    <div class="card">
                        <div class="card-body">
                            <h5><%= listing.productName %></h5>
                            <p><%= listing.category %> • <%= listing.origin %></p>
                            <p class="fw-bold">$<%= listing.price %></p>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</body>
</html>

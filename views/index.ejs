<!DOCTYPE html>
<html>
<head>
    <title>TradeConnect - B2B Platform</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">🏢 TradeConnect</a>
            <div>
                <% if (user) { %>
                    <span class="text-light me-3">Welcome, <%= user.companyName %></span>
                    <a href="/dashboard" class="btn btn-outline-light btn-sm">Dashboard</a>
                    <a href="/auth/logout" class="btn btn-danger btn-sm">Logout</a>
                <% } else { %>
                    <a href="/auth/login" class="btn btn-outline-light btn-sm">Login</a>
                    <a href="/auth/register" class="btn btn-primary btn-sm">Register</a>
                <% } %>
            </div>
        </div>
    </nav>

    <div class="container mt-5">
        <div class="row">
            <div class="col-md-8 mx-auto text-center">
                <h1 class="display-4 fw-bold">Connect Importers & Traders Globally</h1>
                <p class="lead">Find trusted trading partners, post RFQs, and grow your business</p>
                <div class="mt-4">
                    <a href="/auth/register" class="btn btn-primary btn-lg me-2">Get Started</a>
                </div>
            </div>
        </div>

        <hr class="my-5">
        <h2 class="text-center mb-4">Latest Listings</h2>
        <div class="row">
            <% listings.forEach(listing => { %>
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5><%= listing.productName %></h5>
                            <p class="text-muted"><%= listing.category %> • <%= listing.origin %></p>
                            <p class="fw-bold">$<%= listing.price %> <%= listing.currency %></p>
                            <small>MOQ: <%= listing.minOrderQty || 'Contact' %> units</small>
                        </div>
                    </div>
                </div>
            <% }) %>
            <% if (listings.length === 0) { %>
                <p class="text-center text-muted">No listings yet.</p>
            <% } %>
        </div>
    </div>
</body>
</html>

<!DOCTYPE html>
<html>
<head>
    <title>Dashboard - TradeConnect</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">🏢 TradeConnect</a>
            <div>
                <span class="text-light me-3">Welcome, <%= user.companyName %></span>
                <a href="/auth/logout" class="btn btn-danger btn-sm">Logout</a>
            </div>
        </div>
    </nav>

    <div class="container mt-5">
        <h2>Dashboard</h2>
        <p>Role: <strong><%= user.role %></strong></p>
        
        <div class="row mt-4">
            <% if (user.role === 'trader') { %>
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body text-center">
                            <h5>📦 My Listings</h5>
                            <a href="/listings/new" class="btn btn-primary">+ Add New Listing</a>
                        </div>
                    </div>
                </div>
            <% } else if (user.role === 'importer') { %>
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body text-center">
                            <h5>📝 Post RFQ</h5>
                            <a href="/rfq/new" class="btn btn-success">+ Create RFQ</a>
                        </div>
                    </div>
                </div>
            <% } else if (user.role === 'admin') { %>
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body text-center">
                            <h5>⚙️ Admin Panel</h5>
                            <a href="/admin" class="btn btn-danger">Go to Admin</a>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
